# Copy to .env to override defaults. No secrets are needed.

# Where hooks write session state (default: %LOCALAPPDATA%\session-overlay). Re-run --install-hooks after changing.
# DATA_DIR=C:\Users\you\AppData\Local\session-overlay

# Claude Code config dirs to patch, separated by ";" (default: %USERPROFILE%\.claude)
# CLAUDE_CONFIG_DIRS=C:\Users\you\.claude;C:\Users\you\.claude-work

# Widget
CORNER=top-center
MARGIN_PX=16
OPACITY=0.85
FONT_SIZE=9
NAME_MAX_CHARS=42
MAX_ROWS=12
BLINK_ATTENTION=true

# Alerts (banner under the pill). ALERT_SOUND: attention | all | off
ALERTS=true
ALERT_SOUND=attention
ALERT_MIN_RUN_SECONDS=30

# Refresh and pruning
POLL_MS=1000
STALE_RUNNING_MINUTES=15
MAX_AGE_HOURS=24

# Cowork (best-effort)
COWORK_ENABLED=true
COWORK_ACTIVE_SECONDS=45
COWORK_SHOW_HOURS=3
# COWORK_DIRS=C:\Users\you\AppData\Roaming\Claude\local-agent-mode-sessions
